&CONTROL
 calculation='scf', prefix='codex_h2', outdir='./scratch', pseudo_dir='./pseudo',
 disk_io='low', verbosity='high', tprnfor=.true., max_seconds=90,
/
&SYSTEM
 ibrav=1, celldm(1)=18.89726125, nat=2, ntyp=1,
 ecutwfc=80, ecutrho=640, occupations='fixed',
/
&ELECTRONS
 conv_thr=1.0d-9, electron_maxstep=100, mixing_beta=0.3,
/
ATOMIC_SPECIES
 H 1.00794 H.pbe-rrkjus_psl.1.0.0.UPF
ATOMIC_POSITIONS angstrom
 H 5.0 5.0 4.63
 H 5.0 5.0 5.37
K_POINTS gamma
