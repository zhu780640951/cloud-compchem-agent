&CONTROL
  calculation   = 'relax'          ! move atoms only; cell fixed
  restart_mode  = 'from_scratch'
  prefix        = 'phim_sncl6'
  outdir        = './tmp'
  pseudo_dir    = './pseudo'
  tprnfor       = .true.           ! print forces
  tstress       = .true.           ! print stress (diagnostic only; cell is not relaxed)
  forc_conv_thr = 7.8d-4           ! Ry/Bohr  = 0.02 eV/A  (same as the paper)
  etot_conv_thr = 1.0d-4           ! Ry, total-energy change between ionic steps
  nstep         = 300
  max_seconds   = 39600            ! 11 h: stop cleanly and write restart files before a Colab disconnect
  disk_io       = 'low'
/
&SYSTEM
  ibrav         = 0
  nat           = 106
  ntyp          = 6
  ecutwfc       = 60               ! Ry, wavefunction cutoff (above pslibrary 1.0.0 suggestions)
  ecutrho       = 480              ! Ry, charge-density cutoff (8 x ecutwfc for PAW)
  occupations   = 'fixed'          ! insulator
  vdw_corr      = 'dft-d3'
  dftd3_version = 4                ! 4 = D3 with Becke-Johnson damping, D3(BJ)
  dftd3_threebody = .false.        ! two-body only, as in standard VASP IVDW=12
/
&ELECTRONS
  conv_thr      = 1.0d-9           ! Ry, SCF convergence
  mixing_beta   = 0.4
  electron_maxstep = 200
/
&IONS
  ion_dynamics  = 'bfgs'
/
ATOMIC_SPECIES
  Sn  118.710  Sn.pbe-dn-kjpaw_psl.1.0.0.UPF
  Cl   35.453  Cl.pbe-n-kjpaw_psl.1.0.0.UPF
  O    15.999  O.pbe-n-kjpaw_psl.1.0.0.UPF
  N    14.007  N.pbe-n-kjpaw_psl.1.0.0.UPF
  C    12.011  C.pbe-n-kjpaw_psl.1.0.0.UPF
  H     1.008  H.pbe-kjpaw_psl.1.0.0.UPF
