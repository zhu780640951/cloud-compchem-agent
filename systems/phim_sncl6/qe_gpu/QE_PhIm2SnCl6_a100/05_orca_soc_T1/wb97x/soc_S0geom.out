NAME = soc_S0geom.inp
|  1> ! wB97X-D3 ZORA ZORA-def2-SVP SARC/J RIJCOSX TightSCF
|  2> %basis
|  3>   NewGTO Sn "SARC-ZORA-TZVP" end
|  4> end
|  5> %tddft
|  6>   NRoots 10
|  7>   TDA true
|  8>   DoSOC true
|  9>   PrintLevel 3
| 10> end
| 11> %pal nprocs 5 end
| 12> %maxcore 4000
| 13> %pointcharges "mm.pc"
| 14> %scf MaxIter 300 end
| 15> * xyzfile 0 1 crystal.xyz
| 16> 
| 17>                          ****END OF INPUT****
