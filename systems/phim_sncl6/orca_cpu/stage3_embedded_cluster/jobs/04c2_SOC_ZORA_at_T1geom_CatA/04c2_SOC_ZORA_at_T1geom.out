|  3> %maxcore 12000
|  4> %pointcharges "mm_charges.pc"
|  5> %output Print[P_ReducedOrbPopMO_L] 1 end
|  6> %basis NewGTO Sn "SARC-ZORA-TZVP" end end
|  7> %tddft
|  8>   nroots 10
|  9>   triplets true
| 10>   tda true
| 11>   dosoc true
| 12>   TPrint 1e-4
| 13> end
