NAME = 02b_TDA_wB97X_TZVP_PC.inp
|  1> ! wB97X-D3 def2-TZVP def2/J RIJCOSX TightSCF
|  2> %pal nprocs 6 end
|  3> %maxcore 12000
|  4> %pointcharges "mm_charges.pc"
|  5> %output Print[P_ReducedOrbPopMO_L] 1 end
|  6> %tddft
|  7>   nroots 15
|  8>   triplets true
|  9>   tda true
| 10>   TPrint 1e-4
| 11>   DoNTO true
| 12>   NTOStates 1,2,3
| 13> end
| 14> * xyzfile 0 1 qm_cluster.xyz
| 15> 
| 16>                          ****END OF INPUT****
