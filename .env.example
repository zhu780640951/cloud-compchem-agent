# ==============================================================================
# 云端计算化学 Agent 调度模板配置（复制为 .env 或在 PowerShell/Cmd 中注入）
# 请勿将包含真实账号、项目 ID 或密钥路径的 .env 提交到 GitHub
# ==============================================================================

# --- Google Cloud Compute Engine (CPU / ORCA) ---
GCP_PROJECT_ID=your-gcp-project-id
GCP_ZONE=us-central1-a
GCP_INSTANCE=orca-cpu-16
GCP_SSH_USER=your-linux-username
GCP_ACCOUNT=your-gcp-account@gmail.com
GCP_SSH_KEY_PATH=C:\path\to\your\gcp_ssh\google_compute_engine
GCLOUD_SDK_BIN=E:\Google cloud\google-cloud-sdk\bin

# --- Google Colab CLI + Drive (GPU / Quantum ESPRESSO) ---
COLAB_ACCOUNT_EMAIL=your-colab-pro-account@gmail.com
COLAB_CLI_CONFIG_DIR=./local_config/colab-cli
COLAB_CLI_REQUEST_TIMEOUT=45
DRIVE_QE_CACHE_DIR=/content/drive/MyDrive/QE_build/qe-7.5-gpu-sm80
